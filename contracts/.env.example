# Deployment signer. Keep this file local and never commit a real private key.
PRIVATE_KEY=0x
RPC_URL=https://...
EXPECTED_CHAIN_ID=421614             # Chain ID returned by RPC_URL; use 31337 for local Anvil

# Existing ERC20 reserve token on the target network.
RESERVE_TOKEN=0x0000000000000000000000000000000000000000
TEAM_BENEFICIARY=0x0000000000000000000000000000000000000000
TREASURY_BENEFICIARY=0x0000000000000000000000000000000000000000

# Optional CPI updater/relayer. If set, the PSM grants it UPDATER_ROLE during deployment;
# the DAO timelock remains the role admin and can revoke or replace it later.
# CPI_UPDATER=0x0000000000000000000000000000000000000000

# Optional governance settings. Defaults are documented in script/Deploy.s.sol.
# VOTING_DELAY_BLOCKS=1
# VOTING_PERIOD_BLOCKS=50400
# PROPOSAL_THRESHOLD_WHOLE_HLC=100
# QUORUM_PERCENT=4
# TIMELOCK_DELAY_SECONDS=172800
